## Multi-WAN configuration with NAT reflection
## Tests hairpinning with multiple WAN interfaces and gateways

OPTIONS
logging	no

INTERFACES
ext1	eth0	1.2.3.0/24	wan
ext2	eth1	5.6.7.0/24	wan
lan	eth2	192.168.1.0/24
dmz	eth3	10.0.0.0/24

ALIASES
router_ext1_ip	1.2.3.4
router_ext2_ip	5.6.7.8
web_server	192.168.1.100
mail_server	10.0.0.50

FIREWALL
# DNAT from WAN1 with reflection - should use SNAT --to-source 1.2.3.4
ext1 > [router_ext1_ip:443] web_server:443 tcp | reflection

# DNAT from WAN2 with reflection - should use SNAT --to-source 5.6.7.8
ext2 > [router_ext2_ip:25] mail_server:25 tcp | reflection

# Standard masquerade for outgoing traffic
lan [.] > ext1
dmz [.] > ext2

POLICIES
* / *

CUSTOM
