## Dual WAN Setup: FTTC (public IP) + 5G (CGNAT)
## Load balancing scenario with services exposed only on FTTC

OPTIONS
logging	no

INTERFACES
fttc	eth0	1.2.3.0/24	wan
lte5g	eth1	100.64.0.0/10	wan
lan	eth2	192.168.1.0/24

ALIASES
fttc_public	1.2.3.4
web_server	192.168.1.100
mail_server	192.168.1.101

FIREWALL
# ========================================================================
# INCOMING SERVICES - Only via FTTC (has public IP)
# ========================================================================
# Web server with NAT reflection for LAN clients
fttc > [fttc_public:443] web_server:443 tcp | reflection
fttc > [fttc_public:80] web_server:80 tcp | reflection

# Mail server
fttc > [fttc_public:25] mail_server:25 tcp | reflection
fttc > [fttc_public:587] mail_server:587 tcp | reflection

# SSH access to router
* > local:22 tcp

# ========================================================================
# OUTGOING TRAFFIC - Both WANs (for load balancing)
# ========================================================================
# Masquerade for both WAN interfaces
# Load balancing is handled by external routing (see CUSTOM section)
lan [.] > fttc
lan [.] > lte5g

# Allow LAN to communicate with itself
lan > lan

POLICIES
# Default: drop everything else
* / *

CUSTOM
# ========================================================================
# MULTI-WAN LOAD BALANCING CONFIGURATION
# ========================================================================
# This section configures policy routing for load balancing between
# FTTC and 5G connections.
#
# NOTE: This is a basic example. For production use, consider:
# - mwan3 (OpenWrt)
# - failover scripts
# - connection tracking
# - health checks
# ========================================================================

# Create routing tables
# (Add to /etc/iproute2/rt_tables: 1 fttc, 2 lte5g)

# Mark packets for routing
# Example: HTTP/HTTPS via FTTC (lower latency)
-t mangle -A PREROUTING -i eth2 -p tcp -m multiport --dports 80,443 -j MARK --set-mark 1

# Example: Bulk traffic via 5G
-t mangle -A PREROUTING -i eth2 -p tcp --dport 22 -j MARK --set-mark 2

# Preserve marks
-t mangle -A PREROUTING -m connmark --mark 1 -j MARK --set-mark 1
-t mangle -A PREROUTING -m connmark --mark 2 -j MARK --set-mark 2

# Save marks to conntrack
-t mangle -A POSTROUTING -j CONNMARK --save-mark

# ========================================================================
# ROUTING COMMANDS (execute outside Mignis)
# ========================================================================
# Add these to your startup script:
#
# # Define routing tables
# ip route add default via 1.2.3.1 dev eth0 table fttc
# ip route add default via 100.64.0.1 dev eth1 table lte5g
#
# # Route marked packets
# ip rule add fwmark 1 table fttc
# ip rule add fwmark 2 table lte5g
#
# # Load balancing (multipath)
# ip route add default scope global nexthop via 1.2.3.1 dev eth0 weight 1 \
#                                   nexthop via 100.64.0.1 dev eth1 weight 1
# ========================================================================
