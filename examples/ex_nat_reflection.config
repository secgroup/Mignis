## Example configuration with NAT reflection (hairpinning)
## This demonstrates how LAN clients can access services via the public IP

OPTIONS
logging	no

INTERFACES
ext	eth0	1.2.3.0/24	wan
lan	eth1	192.168.1.0/24
dmz	eth2	10.0.0.0/24

ALIASES
router_ext_ip	1.2.3.4
web_server	192.168.1.100
mail_server	10.0.0.50

FIREWALL
# Standard DNAT rule for external access
ext > [router_ext_ip:80] web_server:80 tcp

# DNAT rule with NAT reflection enabled - allows LAN/DMZ clients to access via public IP
ext > [router_ext_ip:443] web_server:443 tcp | reflection

# Mail server in DMZ with reflection
ext > [router_ext_ip:25] mail_server:25 tcp | reflection

# Masquerade for outgoing traffic
lan [.] > ext
dmz [.] > ext

# Allow LAN to access DMZ directly (alternative to using public IP)
lan > dmz

POLICIES
* / *

CUSTOM
